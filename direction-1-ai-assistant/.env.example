# 数据库
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=ledger
MYSQL_USER=ledger
MYSQL_PASSWORD=change_me_db
MYSQL_HOST_PORT=13306

# 后端连接串（本地非 Docker 开发时使用；容器内由 compose 自动覆盖）
DATABASE_URL=mysql+pymysql://ledger:change_me_db@localhost:13306/ledger?charset=utf8mb4

# 文本大模型（OpenAI 兼容接口）
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 小票 / 截图 OCR 视觉模型
VISION_API_KEY=
VISION_API_BASE=
VISION_MODEL=

# 允许跨域的前端地址，多个用逗号分隔
CORS_ORIGINS=http://localhost:8501
